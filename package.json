  "description": "Decentralized Rotating Savings & Credit Associations (ROSCAs) with Soulbound Reputation on NEAR Protocol",
  "private": true,
  "scripts": {
    "build": "npm --prefix contracts run build",
    "build:contract": "npm --prefix contracts run build",
