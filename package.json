{
  "name": "ajo",
  "version": "1.0.0",
  "description": "Ajo is a rotating savings circle with a soulbound credit pass on NEAR",
  "private": true,
  "scripts": {
    "build": "npm --prefix contracts run build",
    "build:contract": "npm --prefix contracts run build",
    "test": "node --test contracts/test/orbit_test.mjs contracts/test/win_path.test.mjs && node contracts/src/keeper_agent.mjs",
    "relay:check": "node contracts/scripts/relay_deposit.mjs",
    "quote:offline": "node contracts/scripts/intents_quote.mjs --offline",
    "quote:dry": "node contracts/scripts/intents_quote.mjs",
    "test:contract": "node --test contracts/test/orbit_test.mjs",
    "test:keeper": "node contracts/src/keeper_agent.mjs",
    "keeper:testnet": "node contracts/src/keeper_agent.mjs --testnet"
  },
  "keywords": [
    "near",
    "blockchain",
    "rosca",
    "ajo",
    "tandas",
    "susu",
    "defi",
    "social-money",
    "real-world-money",
    "soulbound-nft"
